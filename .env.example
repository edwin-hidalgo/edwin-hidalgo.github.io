# Last.fm. The key is read only by api/lately.js and never reaches the browser.
# Create one at https://www.last.fm/api/account/create — read-only use needs no
# shared secret, so do not put one here.
LASTFM_API_KEY=
LASTFM_USER=

# The kill switch. Set to 1 and redeploy; the site stops saying anything about
# what Edwin is listening to. Unset it and redeploy to come back.
LISTENING_PAUSED=
